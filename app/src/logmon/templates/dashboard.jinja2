{% extends "base.jinja2" %}

{% block title %}Dashboard – LogMon{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block content %}
<!-- Stat tiles -->
<div class="grid-4 gap">
  <div class="stat-tile red">
    <div class="stat-label">Errors (24h)</div>
    <div class="stat-value" id="stat-errors">–</div>
    <div class="stat-sub">across all apps</div>
  </div>
  <div class="stat-tile">
    <div class="stat-label">Apps monitored</div>
    <div class="stat-value" id="stat-apps">–</div>
    <div class="stat-sub">with events today</div>
  </div>
  <div class="stat-tile yellow">
    <div class="stat-label">SNS notifications</div>
    <div class="stat-value" id="stat-sns">–</div>
    <div class="stat-sub">past 7 days</div>
  </div>
  <div class="stat-tile green">
    <div class="stat-label">Status</div>
    <div class="stat-value" style="font-size:18px">● Live</div>
    <div class="stat-sub">log follower active</div>
  </div>
</div>

<!-- Bad-actor alert tile — hidden until at least one IP breaches the threshold -->
<div class="gap" id="bad-actor-alert" style="display:none;">
  <div class="card" style="border-left:4px solid var(--red);">
    <div class="card-header" style="color:var(--red);">
      ⚠ Bad Actors Detected
      <a href="{{ url_for('access.index') }}" class="btn btn-ghost" style="padding:3px 10px;font-size:11px;">View report →</a>
    </div>
    <div class="card-body" style="padding:10px 18px;" id="bad-actor-body">
      <div class="text-muted" style="font-size:12px;">Loading…</div>
    </div>
  </div>
</div>

<div class="card mb-3" id="disk-tile">
  <div class="card-header">
    <span>Disk Usage</span>
    <a href="{{ url_for('disk.disk_detail') }}" class="btn btn-ghost" style="font-size:11px;padding:3px 10px;">Details →</a>
  </div>
  <div class="card-body" id="disk-tile-body">
    <div style="color:var(--text-dim);text-align:center;">Loading…</div>
  </div>
  <div style="padding:6px 18px 8px;border-top:1px solid var(--border);">
    <span class="disk-collected-at" id="disk-tile-collected-at"></span>
  </div>
</div>

<div class="card mb-3" id="mem-tile">
  <div class="card-header">
    <span>Memory &amp; Swap</span>
    <a href="{{ url_for('mem.mem_history') }}" class="btn btn-ghost" style="font-size:11px;padding:3px 10px;">History →</a>
  </div>
  <div class="card-body" id="mem-tile-body">
    <div style="color:var(--text-dim);text-align:center;">Loading…</div>
  </div>
  <div style="padding:6px 18px 8px;border-top:1px solid var(--border);">
    <span class="disk-collected-at" id="mem-tile-collected-at"></span>
  </div>
</div>

<!-- Per-app error bar -->
<div class="gap">
  <div class="card">
    <div class="card-header">
      Errors by app — last 24 h
      <a href="{{ url_for('logs.index') }}" class="btn btn-ghost" style="padding:3px 10px;font-size:11px;">Browse all →</a>
    </div>
    <div class="card-body" style="padding:14px 18px;" id="app-error-bars">
      <div class="text-muted" style="font-size:12px;">Loading…</div>
    </div>
  </div>
</div>

<div class="grid-2 gap">
  <!-- Recent errors -->
  <div class="card">
    <div class="card-header">Recent Errors</div>
    <table class="data-table">
      <thead>
        <tr>
          <th>App</th>
          <th>Time</th>
          <th>Exception / URL</th>
        </tr>
      </thead>
      <tbody id="recent-errors-body">
        <tr><td colspan="3" class="text-muted">Loading…</td></tr>
      </tbody>
    </table>
  </div>

  <!-- Recent SNS -->
  <div class="card">
    <div class="card-header">
      Recent SNS Notifications
      <a href="{{ url_for('sns.index') }}" class="btn btn-ghost" style="padding:3px 10px;font-size:11px;">All →</a>
    </div>
    <table class="data-table">
      <thead>
        <tr>
          <th>Time</th>
          <th>Type</th>
          <th>Subject</th>
        </tr>
      </thead>
      <tbody id="recent-sns-body">
        <tr><td colspan="3" class="text-muted">Loading…</td></tr>
      </tbody>
    </table>
  </div>
</div>

{% endblock %}

{% block scripts %}
<script>
const LOG_URL   = {{ url_for('logs.app_log', app_name='__APP__') | tojson }};
const EVENT_URL = {{ url_for('logs.event_detail', app_name='__APP__', event_id=0) | tojson }};

function appLogUrl(appName) {
  return LOG_URL.replace('__APP__', encodeURIComponent(appName));
}
function eventUrl(appName, eventId) {
  return EVENT_URL
    .replace('__APP__', encodeURIComponent(appName))
    .replace('0', eventId);
}

// ---------------------------------------------------------------- stats + bars
function refreshStats() {
  fetch('/api/stats')
    .then(r => r.json())
    .then(data => {
      const entries = Object.entries(data);
      const total = entries.reduce((a, [, v]) => a + v, 0);
      document.getElementById('stat-errors').textContent = total;
      document.getElementById('stat-apps').textContent   = entries.length;

      const barsEl = document.getElementById('app-error-bars');
      if (!entries.length) {
        barsEl.innerHTML = '<div class="text-muted" style="font-size:12px;">No errors recorded in the last 24 hours.</div>';
        return;
      }
      const maxCount = Math.max(...entries.map(([, v]) => v));
      barsEl.innerHTML = entries.map(([appName, count]) => `
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
          <div style="width:130px;color:var(--text-muted);font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${appName}</div>
          <div style="flex:1;background:var(--bg3);border-radius:2px;height:8px;overflow:hidden;">
            <div style="height:100%;background:var(--red);opacity:0.7;width:${Math.round(count/maxCount*100)}%;border-radius:2px;"></div>
          </div>
          <div style="width:40px;text-align:right;color:var(--red);font-size:12px;">${count}</div>
          <a href="${appLogUrl(appName)}" style="font-size:11px;">view</a>
        </div>`).join('');
    });
}

// ---------------------------------------------------------------- recent errors
function refreshErrors() {
  fetch('/api/recent_errors?n=20')
    .then(r => r.json())
    .then(events => {
      const tbody = document.getElementById('recent-errors-body');
      if (!events.length) {
        tbody.innerHTML = '<tr><td colspan="3" class="text-muted">No errors recorded yet.</td></tr>';
        return;
      }
      tbody.innerHTML = events.map(e => {
        const ts      = e.occurred_at ? e.occurred_at.replace('T',' ').slice(0,19) : '–';
        const label   = e.exception_type || e.message || '–';
        const truncated = label.length > 60 ? label.slice(0,60) + '…' : label;
        return `<tr>
          <td><a href="${appLogUrl(e.app_name)}">${e.app_name}</a></td>
          <td class="text-muted" style="white-space:nowrap;">${ts}</td>
          <td><a href="${eventUrl(e.app_name, e.id)}" class="truncate" style="display:block;max-width:260px;" title="${label}">${truncated}</a></td>
        </tr>`;
      }).join('');
    });
}

// ---------------------------------------------------------------- recent SNS
function refreshSns() {
  fetch('/api/sns/recent?days=7')
    .then(r => r.json())
    .then(items => {
      const tbody = document.getElementById('recent-sns-body');
      document.getElementById('stat-sns').textContent = items.length;
      if (!items.length) {
        tbody.innerHTML = '<tr><td colspan="3" class="text-muted">No SNS notifications yet.</td></tr>';
        return;
      }
      tbody.innerHTML = items.map(s => {
        const ts = s.received_at ? s.received_at.replace('T',' ').slice(0,16) : '–';
        return `<tr>
          <td class="text-muted" style="white-space:nowrap;">${ts}</td>
          <td><span class="badge badge-grey">${s.notification_type || ''}</span></td>
          <td class="truncate">${s.subject || '–'}</td>
        </tr>`;
      }).join('');
    });
}

// ---------------------------------------------------------------- bad-actor tile
function refreshBadActors() {
  fetch('/api/access/bad_actors/summary')
    .then(r => r.json())
    .then(data => {
      const actors = data.actors || [];
      if (!actors.length) return;   // tile stays hidden

      document.getElementById('bad-actor-alert').style.display = '';
      const threshold = data.threshold;
      const hours     = data.hours;

      const rows = actors.slice(0, 5).map(a => {
        const errPart = a.error_count
          ? ` <span style="color:var(--yellow);">(${a.error_count.toLocaleString()} 4xx/5xx)</span>`
          : '';
        return `<div style="display:flex;gap:16px;align-items:center;margin-bottom:4px;font-size:12px;">
           <span style="font-family:monospace;min-width:120px;">${a.ip}</span>
           <span class="badge badge-grey">${a.country}</span>
           <span style="color:var(--red);">${a.count.toLocaleString()} req</span>${errPart}
         </div>`;
      }).join('');

      const more = actors.length > 5
        ? `<div class="text-muted" style="font-size:11px;margin-top:6px;">…and ${actors.length - 5} more above ${threshold.toLocaleString()} requests in ${hours}h</div>`
        : '';

      document.getElementById('bad-actor-body').innerHTML = rows + more;
    })
    .catch(() => {});   // silently skip if access blueprint not yet wired
}

// ---------------------------------------------------------------- boot + interval
function refreshAll() {
  refreshStats();
  refreshErrors();
  refreshSns();
  refreshBadActors();
}

refreshAll();
setInterval(refreshAll, 30000);

(function () {
  "use strict";

  const THRESHOLD_PCT = {{ disk_threshold_pct | default(85) }};

  function fmtKb(kb) {
    if (kb >= 1048576) return (kb / 1048576).toFixed(1) + " GB";
    if (kb >= 1024)    return (kb / 1024).toFixed(1) + " MB";
    return kb + " KB";
  }

  function fmtBytes(b) {
    if (b == null || b === 0) return "0 B";
    if (b >= 1e9) return (b / 1e9).toFixed(1) + " GB";
    if (b >= 1e6) return (b / 1e6).toFixed(1) + " MB";
    if (b >= 1e3) return (b / 1e3).toFixed(1) + " kB";
    return b + " B";
  }

  function barClass(pct) {
    if (pct >= THRESHOLD_PCT)      return "danger";
    if (pct >= THRESHOLD_PCT - 10) return "warn";
    return "ok";
  }

  function renderTile(data) {
    const body  = document.getElementById("disk-tile-body");
    const lines = [];

    // --- one row per filesystem ---
    (data.filesystems || []).forEach(fs => {
      const cls   = barClass(fs.use_pct);
      const alert = fs.use_pct >= THRESHOLD_PCT
        ? `<span class="disk-alert-badge">⚠</span>` : "";
      lines.push(`
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:7px;">
          <code style="min-width:9rem;font-size:11px;color:var(--text-muted);">${fs.mount}</code>
          <div class="disk-bar-wrap" style="flex:1;">
            <div class="disk-bar-fill ${cls}" style="width:${fs.use_pct}%"></div>
          </div>
          <span style="min-width:6rem;text-align:right;font-size:11px;color:var(--text-muted);">
            ${fmtKb(fs.used_kb)} / ${fmtKb(fs.total_kb)}
          </span>
          <span style="min-width:2.5rem;text-align:right;font-size:11px;">${fs.use_pct}%${alert}</span>
        </div>`);
    });

    // --- Docker summary strip ---
    const d = data.docker;
    if (d) {
      const total = (d.images_size_bytes || 0)
                  + (d.containers_size_bytes || 0)
                  + (d.volumes_size_bytes || 0)
                  + (d.build_cache_size_bytes || 0);
      const reclaim = (d.images_reclaimable_bytes || 0)
                    + (d.volumes_reclaimable_bytes || 0)
                    + (d.build_cache_reclaimable_bytes || 0);
      lines.push(`
        <div class="disk-docker-strip">
          <span class="strip-label">Docker</span>
          <span>${fmtBytes(total)} total</span>
          <span style="color:var(--text-dim)">·</span>
          <span>${fmtBytes(d.images_size_bytes)} images</span>
          <span style="color:var(--text-dim)">·</span>
          <span>${fmtBytes(d.volumes_size_bytes)} volumes</span>
          <span style="color:var(--text-dim)">·</span>
          <span class="strip-reclaim">${fmtBytes(reclaim)} reclaimable</span>
        </div>`);
    }

    body.innerHTML = lines.length
      ? lines.join("")
      : '<div style="color:var(--text-dim);text-align:center;">No data yet</div>';

    const ts = document.getElementById("disk-tile-collected-at");
    if (data.collected_at) ts.textContent = "updated " + data.collected_at;
  }

  function load() {
    fetch("{{ url_for('api.api_disk_summary') }}")
      .then(r => r.ok ? r.json() : Promise.reject(r.status))
      .then(renderTile)
      .catch(err => {
        document.getElementById("disk-tile-body").innerHTML =
          `<div style="color:var(--red);text-align:center;">Disk data unavailable (${err})</div>`;
      });
  }

  document.addEventListener("DOMContentLoaded", load);
  setInterval(load, 60000);
})();

(function () {
  "use strict";

  const SWAP_THRESHOLD_PCT = {{ swap_threshold_pct | default(50) }};

  function fmtKb(kb) {
    if (kb >= 1048576) return (kb / 1048576).toFixed(1) + " GB";
    if (kb >= 1024)    return (kb / 1024).toFixed(1) + " MB";
    return kb + " KB";
  }

  function barClass(pct, threshold) {
    if (pct >= threshold)      return "danger";
    if (pct >= threshold - 15) return "warn";
    return "ok";
  }

  function renderMemTile(data) {
    const body  = document.getElementById("mem-tile-body");
    const lines = [];

    const mem = data.mem || {};
    if (mem.total_kb) {
      lines.push(`
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:7px;">
          <code style="min-width:9rem;font-size:11px;color:var(--text-muted);">RAM</code>
          <div class="disk-bar-wrap" style="flex:1;">
            <div class="disk-bar-fill ok" style="width:${mem.pct}%"></div>
          </div>
          <span style="min-width:6rem;text-align:right;font-size:11px;color:var(--text-muted);">
            ${fmtKb(mem.used_kb)} / ${fmtKb(mem.total_kb)}
          </span>
          <span style="min-width:2.5rem;text-align:right;font-size:11px;">${mem.pct}%</span>
        </div>`);
    }

    const swap = data.swap || {};
    if (swap.total_kb > 0) {
      const cls   = barClass(swap.pct, SWAP_THRESHOLD_PCT);
      const alert = swap.pct >= SWAP_THRESHOLD_PCT
        ? `<span class="disk-alert-badge">⚠</span>` : "";
      lines.push(`
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:7px;">
          <code style="min-width:9rem;font-size:11px;color:var(--text-muted);">Swap</code>
          <div class="disk-bar-wrap" style="flex:1;">
            <div class="disk-bar-fill ${cls}" style="width:${swap.pct}%"></div>
          </div>
          <span style="min-width:6rem;text-align:right;font-size:11px;color:var(--text-muted);">
            ${fmtKb(swap.used_kb)} / ${fmtKb(swap.total_kb)}
          </span>
          <span style="min-width:2.5rem;text-align:right;font-size:11px;">${swap.pct}%${alert}</span>
        </div>`);
    } else if (swap.total_kb === 0) {
      lines.push(`<div style="font-size:11px;color:var(--text-dim);">No swap configured</div>`);
    }

    body.innerHTML = lines.length
      ? lines.join("")
      : '<div style="color:var(--text-dim);text-align:center;">No data yet</div>';

    const ts = document.getElementById("mem-tile-collected-at");
    if (data.collected_at) ts.textContent = "updated " + data.collected_at;
  }

  function loadMem() {
    fetch("{{ url_for('api.api_mem_summary') }}")
      .then(r => r.ok ? r.json() : Promise.reject(r.status))
      .then(renderMemTile)
      .catch(err => {
        document.getElementById("mem-tile-body").innerHTML =
          `<div style="color:var(--red);text-align:center;">Memory data unavailable (${err})</div>`;
      });
  }

  document.addEventListener("DOMContentLoaded", loadMem);
  setInterval(loadMem, 60000);
})();
</script>
{% endblock %}
