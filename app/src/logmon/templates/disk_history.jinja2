{% extends "base.jinja2" %}

{% block title %}Disk History – LogMon{% endblock %}
{% block page_title %}Disk History{% endblock %}

{% block head_extra %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
{% endblock %}

{% block content %}

<!-- Controls -->
<div class="card gap">
  <div class="card-body" style="padding:14px 18px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <button class="btn btn-ghost range-btn" data-days="7">7 days</button>
    <button class="btn btn-ghost range-btn" data-days="30">30 days</button>
    <span id="history-status" style="margin-left:10px;font-size:11px;color:var(--text-muted);"></span>
  </div>
</div>

<!-- Filesystem combined chart + checklist -->
<div class="disk-section-heading">Filesystem Usage % Over Time</div>
<div class="card gap" id="fs-chart-card" style="display:none;">
  <div class="card-body" style="padding:14px 18px;">
    <!-- Mount checklist -->
    <div id="mount-checklist" style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px;"></div>
    <!-- Chart -->
    <div style="position:relative;min-height:260px;">
      <canvas id="fs-chart"></canvas>
    </div>
  </div>
</div>
<div id="fs-loading" class="disk-no-data">Select a time range above.</div>
<div id="fs-unavailable" class="disk-no-data" style="display:none;">
  No filesystem history available for this window.
</div>

<!-- Docker chart -->
<div class="disk-section-heading" style="margin-top:32px;">Docker Usage Over Time</div>
<div class="card gap" id="docker-chart-wrap" style="display:none;">
  <div class="card-header">Docker component sizes</div>
  <div class="card-body" style="padding:14px 18px;position:relative;min-height:220px;">
    <canvas id="docker-chart"></canvas>
  </div>
</div>
<div id="docker-unavailable" class="disk-no-data" style="display:none;">
  No Docker history available.
</div>

{% endblock %}

{% block scripts %}
<script>
(function () {
  "use strict";

  const THRESHOLD_PCT = {{ threshold_pct | default(85) }};

  // Colour palette for filesystem series — cycles if more mounts than entries
  const FS_PALETTE = ['--accent', '--green', '--cyan', '--purple', '--orange', '--yellow'];

  // ---------------------------------------------------------------- css vars
  function cv(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }

  // ---------------------------------------------------------------- helpers
  function fmtKb(kb) {
    if (kb == null) return "–";
    if (kb >= 1048576) return (kb / 1048576).toFixed(1) + " GB";
    if (kb >= 1024)    return (kb / 1024).toFixed(1)   + " MB";
    return kb + " KB";
  }

  function fmtBytes(b) {
    if (b == null) return "–";
    if (b >= 1e9) return (b / 1e9).toFixed(1) + " GB";
    if (b >= 1e6) return (b / 1e6).toFixed(1) + " MB";
    if (b >= 1e3) return (b / 1e3).toFixed(1) + " kB";
    return b + " B";
  }

  function fmtTs(isoStr) {
    const d = new Date(isoStr);
    return d.toLocaleString([], {
      month: 'short', day: 'numeric',
      hour: '2-digit', minute: '2-digit',
      hour12: false,
    });
  }

  function tickLabel(dates, idx, spanDays) {
    if (idx < 0 || idx >= dates.length) return '';
    const d    = new Date(dates[idx]);
    const time = d.toLocaleTimeString([], {hour: '2-digit', minute: '2-digit', hour12: false});
    if (!spanDays) return time;
    return [d.toLocaleDateString([], {month: 'short', day: 'numeric'}), time];
  }

  // ---------------------------------------------------------------- chart instances
  let _fsChart     = null;
  let _dockerChart = null;

  function destroyAll() {
    if (_fsChart)     { _fsChart.destroy();     _fsChart     = null; }
    if (_dockerChart) { _dockerChart.destroy();  _dockerChart = null; }
  }

  // ---------------------------------------------------------------- base chart options
  function baseOptions(dates, yLabel, yFmt) {
    const spanDays = dates.length > 1 && (
      new Date(dates[0]).toLocaleDateString() !==
      new Date(dates[dates.length - 1]).toLocaleDateString()
    );
    return {
      responsive: true,
      animation:  false,
      interaction: { mode: 'index', axis: 'x', intersect: false },
      scales: {
        x: {
          ticks: {
            color:         cv('--text-muted'),
            maxTicksLimit: spanDays ? 14 : 12,
            font:          { size: 10 },
            minRotation:   spanDays ? 30 : 0,
            maxRotation:   spanDays ? 45 : 0,
            callback(val)  { return tickLabel(dates, Math.round(val), spanDays); },
          },
          grid: { color: cv('--border') },
        },
        y: {
          title: { display: true, text: yLabel, color: cv('--text-muted'), font: { size: 10 } },
          ticks: { color: cv('--text-muted'), font: { size: 10 }, callback: yFmt },
          grid:  { color: cv('--border') },
        },
      },
      plugins: {
        legend: { labels: { color: cv('--text-muted'), font: { size: 11 } } },
        tooltip: {
          backgroundColor: cv('--bg3'),
          titleColor:      cv('--text'),
          bodyColor:       cv('--text-muted'),
          borderColor:     cv('--border2'),
          borderWidth:     1,
          callbacks: {
            title: items => fmtTs(dates[items[0].dataIndex]),
            label: ctx   => ' ' + ctx.dataset.label + ': ' + yFmt(ctx.parsed.y),
          },
        },
      },
    };
  }

  // ---------------------------------------------------------------- state
  // allSeries: { mount: [{collected_at, use_pct, used_kb, total_kb}, ...] }
  let allSeries     = {};
  let checkedMounts = new Set();
  // mount → palette index (stable across checklist changes)
  let mountColors   = {};

  // ---------------------------------------------------------------- build/update filesystem chart
  function buildFsChart() {
    const mounts = [...checkedMounts].sort();

    // Use the longest series as the x-axis reference so all points are covered
    const refMount = Object.keys(allSeries).sort(
      (a, b) => (allSeries[b] || []).length - (allSeries[a] || []).length
    )[0];
    const dates = refMount ? (allSeries[refMount] || []).map(p => p.collected_at) : [];

    if (!dates.length) return;

    const datasets = mounts.map(mount => {
      const colorVar = FS_PALETTE[mountColors[mount] % FS_PALETTE.length];
      const color    = cv(colorVar);
      const points   = allSeries[mount] || [];
      return {
        label:           mount,
        data:            points.map(p => p.use_pct),
        borderColor:     color,
        backgroundColor: color + '22',
        borderWidth:     1.5,
        pointRadius:     points.length > 300 ? 0 : 2,
        fill:            false,
        tension:         0.2,
      };
    });

    // Dashed threshold line
    datasets.push({
      label:       'Threshold (' + THRESHOLD_PCT + '%)',
      data:        dates.map(() => THRESHOLD_PCT),
      borderColor: cv('--red') + '88',
      borderWidth: 1,
      borderDash:  [4, 4],
      pointRadius: 0,
      fill:        false,
    });

    const opts       = baseOptions(dates, 'Use %', v => v + '%');
    opts.scales.y.min = 0;
    opts.scales.y.max = 100;

    if (_fsChart) {
      _fsChart.data.labels   = dates.map((_, i) => i);
      _fsChart.data.datasets = datasets;
      _fsChart.update('none');
    } else {
      _fsChart = new Chart(
        document.getElementById('fs-chart').getContext('2d'),
        { type: 'line', data: { labels: dates.map((_, i) => i), datasets }, options: opts }
      );
    }
  }

  // ---------------------------------------------------------------- render checklist
  function renderChecklist(mounts) {
    const wrap = document.getElementById('mount-checklist');
    wrap.innerHTML = '';

    mounts.forEach(mount => {
      const colorVar = FS_PALETTE[mountColors[mount] % FS_PALETTE.length];
      const color    = cv(colorVar);
      const checked  = checkedMounts.has(mount);

      const pill = document.createElement('button');
      pill.className         = 'btn btn-ghost';
      pill.dataset.mount     = mount;
      pill.style.cssText     = `
        font-size:11px;padding:3px 10px;
        border-color:${color}66;
        display:inline-flex;align-items:center;gap:5px;
        ${checked ? `background:${color}22;color:${cv('--text')};` : `color:${cv('--text-muted')};`}
      `;
      pill.innerHTML = `<span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:${color};flex-shrink:0;"></span>${mount}`;

      pill.addEventListener('click', () => {
        if (checkedMounts.has(mount)) {
          checkedMounts.delete(mount);
          pill.style.background = 'transparent';
          pill.style.color      = cv('--text-muted');
        } else {
          checkedMounts.add(mount);
          pill.style.background = color + '22';
          pill.style.color      = cv('--text');
        }
        buildFsChart();
      });

      wrap.appendChild(pill);
    });
  }

  // ---------------------------------------------------------------- render Docker chart
  function renderDockerChart(points) {
    const wrap    = document.getElementById('docker-chart-wrap');
    const unavail = document.getElementById('docker-unavailable');

    if (!points || points.length === 0) {
      unavail.style.display = '';
      return;
    }

    wrap.style.display = '';
    const dates = points.map(p => p.collected_at);

    const datasets = [
      { label: 'Images',      key: 'images_size_bytes',     color: '--accent'  },
      { label: 'Volumes',     key: 'volumes_size_bytes',     color: '--green'   },
      { label: 'Build cache', key: 'build_cache_size_bytes', color: '--yellow'  },
      { label: 'Containers',  key: 'containers_size_bytes',  color: '--purple'  },
    ].map(ds => ({
      label:           ds.label,
      data:            points.map(p => p[ds.key] || 0),
      borderColor:     cv(ds.color),
      backgroundColor: cv(ds.color) + '22',
      borderWidth:     1.5,
      pointRadius:     points.length > 300 ? 0 : 2,
      fill:            false,
      tension:         0.2,
    }));

    const opts = baseOptions(dates, 'Size', fmtBytes);

    if (_dockerChart) { _dockerChart.destroy(); _dockerChart = null; }
    _dockerChart = new Chart(
      document.getElementById('docker-chart').getContext('2d'),
      { type: 'line', data: { labels: dates.map((_, i) => i), datasets }, options: opts }
    );
  }

  // ---------------------------------------------------------------- load
  function load(days) {
    document.getElementById('history-status').textContent      = 'Loading…';
    document.getElementById('fs-loading').style.display        = '';
    document.getElementById('fs-chart-card').style.display     = 'none';
    document.getElementById('fs-unavailable').style.display    = 'none';
    document.getElementById('docker-chart-wrap').style.display = 'none';
    document.getElementById('docker-unavailable').style.display= 'none';
    destroyAll();

    const hours     = days * 24;
    const fsUrl     = `{{ url_for('api.api_disk_history') }}?hours=${hours}`;
    const dockerUrl = `{{ url_for('api.api_disk_history') }}?docker=1&hours=${hours}`;

    Promise.all([
      fetch(fsUrl).then(r => r.ok ? r.json() : Promise.reject(r.status)),
      fetch(dockerUrl).then(r => r.ok ? r.json() : Promise.reject(r.status)),
    ])
    .then(([fsData, dockerData]) => {
      document.getElementById('fs-loading').style.display = 'none';

      allSeries = fsData.series || {};
      const mounts = Object.keys(allSeries).sort();

      if (mounts.length === 0) {
        document.getElementById('fs-unavailable').style.display = '';
      } else {
        // Assign stable colour indices
        mountColors = {};
        mounts.forEach((m, i) => { mountColors[m] = i; });
        // Default: all mounts selected
        checkedMounts = new Set(mounts);
        renderChecklist(mounts);
        document.getElementById('fs-chart-card').style.display = '';
        buildFsChart();
      }

      renderDockerChart(dockerData.points || []);

      const fsCount     = Object.values(allSeries).reduce((n, pts) => n + pts.length, 0);
      const dockerCount = (dockerData.points || []).length;
      document.getElementById('history-status').textContent =
        `${fsCount} filesystem samples · ${dockerCount} Docker samples`;
    })
    .catch(err => {
      document.getElementById('fs-loading').style.display        = 'none';
      document.getElementById('fs-unavailable').style.display    = '';
      document.getElementById('fs-unavailable').style.color      = cv('--red');
      document.getElementById('fs-unavailable').textContent      = `Failed to load history (${err})`;
      document.getElementById('history-status').textContent      = '';
    });
  }

  // ---------------------------------------------------------------- range buttons
  document.querySelectorAll('.range-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.range-btn').forEach(b => {
        b.classList.remove('btn-primary');
        b.classList.add('btn-ghost');
      });
      btn.classList.remove('btn-ghost');
      btn.classList.add('btn-primary');
      load(parseInt(btn.dataset.days, 10));
    });
  });

  // ---------------------------------------------------------------- boot
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelector('.range-btn[data-days="7"]').click();
  });
})();
</script>
{% endblock %}
