{% extends "base.jinja2" %}

{% block title %}CPU Utilization – LogMon{% endblock %}
{% block page_title %}CPU Utilization{% endblock %}

{% block head_extra %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
{% endblock %}

{% block content %}

<!-- Controls -->
<div class="card gap">
  <div class="card-body" style="padding:14px 18px;display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">

    <div>
      <label class="form-label" style="font-size:11px;color:var(--text-muted);display:block;margin-bottom:3px;">From</label>
      <input type="datetime-local" id="ctrl-start" class="form-control" style="font-size:12px;">
    </div>
    <div>
      <label class="form-label" style="font-size:11px;color:var(--text-muted);display:block;margin-bottom:3px;">To</label>
      <input type="datetime-local" id="ctrl-end" class="form-control" style="font-size:12px;">
    </div>

    <div style="display:flex;gap:6px;flex-wrap:wrap;align-self:flex-end;">
      <button class="btn btn-ghost quick-range" data-hours="1">1 h</button>
      <button class="btn btn-ghost quick-range" data-hours="6">6 h</button>
      <button class="btn btn-ghost quick-range" data-hours="24">24 h</button>
      <button class="btn btn-ghost quick-range" data-hours="72">3 d</button>
      <button class="btn btn-ghost quick-range" data-hours="168">7 d</button>
    </div>

    <button class="btn btn-primary" id="btn-refresh" style="align-self:flex-end;">Load</button>
  </div>
</div>

<!-- Summary stat tiles -->
<div class="grid-3 gap" id="stat-tiles" style="display:none;">
  <div class="stat-tile">
    <div class="stat-label">Average CPU</div>
    <div class="stat-value" id="stat-avg">–</div>
  </div>
  <div class="stat-tile yellow">
    <div class="stat-label">Peak CPU</div>
    <div class="stat-value" id="stat-peak">–</div>
  </div>
  <div class="stat-tile">
    <div class="stat-label">Data points</div>
    <div class="stat-value" id="stat-count" style="font-size:18px;">–</div>
  </div>
</div>

<!-- Chart -->
<div class="card gap">
  <div class="card-header">CPU Utilization (%)</div>
  <div class="card-body" style="padding:14px 18px;position:relative;min-height:260px;">
    <div id="cpu-loading" class="text-muted" style="font-size:12px;text-align:center;padding:40px 0;">
      Set a time window and click Load.
    </div>
    <canvas id="cpu-chart" style="display:none;"></canvas>
  </div>
</div>

<!-- Note if DO credentials not configured -->
<div class="card gap" id="no-creds-card" style="display:none;">
  <div class="card-body" style="padding:14px 18px;color:var(--yellow);font-size:12px;">
    ⚠ No data returned. Ensure <code>DO_API_TOKEN</code> and <code>DO_HOST_ID</code>
    are set in your application configuration.
  </div>
</div>

{% endblock %}

{% block scripts %}
<script>
let _chart = null;

// ---------------------------------------------------------------- init pickers
(function () {
  const fmt = dt => dt.toISOString().slice(0, 16);
  const now = new Date();
  document.getElementById('ctrl-end').value   = fmt(now);
  document.getElementById('ctrl-start').value = fmt(new Date(now - 86400e3));
})();

document.querySelectorAll('.quick-range').forEach(btn => {
  btn.addEventListener('click', () => {
    const h = parseInt(btn.dataset.hours, 10);
    const fmt = dt => dt.toISOString().slice(0, 16);
    const now = new Date();
    document.getElementById('ctrl-end').value   = fmt(now);
    document.getElementById('ctrl-start').value = fmt(new Date(now - h * 3600e3));
  });
});

// ---------------------------------------------------------------- fetch
document.getElementById('btn-refresh').addEventListener('click', fetchCpu);

// ---------------------------------------------------------------- fetch
document.getElementById('btn-refresh').addEventListener('click', fetchCpu);

function fetchCpu() {
  const start = document.getElementById('ctrl-start').value;
  const end   = document.getElementById('ctrl-end').value;

  document.getElementById('cpu-loading').textContent = 'Loading…';
  document.getElementById('cpu-loading').style.display = '';
  document.getElementById('cpu-chart').style.display = 'none';
  document.getElementById('stat-tiles').style.display = 'none';
  document.getElementById('no-creds-card').style.display = 'none';

  const qs  = `start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}`;

  Promise.all([
    fetch(`/api/access/cpu?${qs}`).then(r => r.json()),
    fetch(`/api/access/rate?${qs}`).then(r => r.json()),
  ])
    .then(([cpuData, rateData]) => {
      const pts  = cpuData.points  || [];
      const rate = rateData.points || [];
      if (!pts.length) {
        document.getElementById('cpu-loading').textContent = 'No data returned for this window.';
        document.getElementById('no-creds-card').style.display = '';
        return;
      }
      document.getElementById('cpu-loading').style.display = 'none';
      renderChart(pts, rate);
      renderStats(pts);
    })
    .catch(err => {
      document.getElementById('cpu-loading').textContent = `Error: ${err}`;
    });
}

// ---------------------------------------------------------------- chart
function renderChart(pts, ratePts) {
  const dates    = pts.map(p => new Date(p.timestamp));
  const cpuVals  = pts.map(p => p.cpu_pct);
  const rateVals = (ratePts || []).map(p => p.req_count);
  const labels   = dates.map((_, i) => i);

  const spanDays = dates.length > 1
    && dates[0].toLocaleDateString() !== dates[dates.length - 1].toLocaleDateString();

  const canvas = document.getElementById('cpu-chart');
  canvas.style.display = '';

  const bg     = getComputedStyle(document.documentElement).getPropertyValue('--bg3').trim()  || '#1a1a2e';
  const accent = getComputedStyle(document.documentElement).getPropertyValue('--blue').trim() || '#4a90e2';
  const green  = getComputedStyle(document.documentElement).getPropertyValue('--green').trim() || '#4caf50';
  const text   = getComputedStyle(document.documentElement).getPropertyValue('--text').trim() || '#ccc';

  if (_chart) _chart.destroy();

  _chart = new Chart(canvas, {
    type: 'line',
    data: {
      labels,
      datasets: [
        {
          label: 'CPU %',
          data: cpuVals,
          borderColor: accent,
          backgroundColor: accent + '22',
          borderWidth: 1.5,
          pointRadius: pts.length > 200 ? 0 : 2,
          fill: true,
          tension: 0.3,
          yAxisID: 'yCpu',
        },
        {
          label: 'Requests',
          data: rateVals,
          borderColor: green,
          backgroundColor: green + '18',
          borderWidth: 1.5,
          pointRadius: pts.length > 200 ? 0 : 2,
          fill: true,
          tension: 0.3,
          yAxisID: 'yReq',
        },
      ],
    },
    options: {
      responsive: true,
      animation: false,
      interaction: { mode: 'index', axis: 'x', intersect: false },
      scales: {
        x: {
          ticks: {
            color: text,
            maxTicksLimit: spanDays ? 14 : 12,
            font: { size: 10 },
            minRotation: spanDays ? 30 : 0,
            maxRotation: spanDays ? 45 : 0,
            callback(val) {
              const idx = Math.round(val);
              if (idx < 0 || idx >= dates.length) return '';
              const d    = dates[idx];
              const time = d.toLocaleTimeString([], {hour: '2-digit', minute: '2-digit', hour12: false});
              if (!spanDays) return time;
              const day = d.toLocaleDateString([], {month: 'short', day: 'numeric'});
              return [day, time];
            },
          },
          grid: { color: bg },
        },
        yCpu: {
          type: 'linear',
          position: 'left',
          min: 0,
          max: 100,
          ticks: {
            color: accent,
            callback: v => v + '%',
            font: { size: 10 },
          },
          grid: { color: bg },
          title: { display: true, text: 'CPU %', color: accent, font: { size: 10 } },
        },
        yReq: {
          type: 'linear',
          position: 'right',
          min: 0,
          ticks: {
            color: green,
            font: { size: 10 },
          },
          grid: { drawOnChartArea: false },   // no grid lines for the right axis
          title: { display: true, text: 'Requests / min', color: green, font: { size: 10 } },
        },
      },
      plugins: {
        legend: { display: true, labels: { color: text, font: { size: 11 } } },
        tooltip: {
          callbacks: {
            title: items => {
              const d = dates[items[0].dataIndex];
              return d.toLocaleString([], {
                month: 'short', day: 'numeric',
                hour: '2-digit', minute: '2-digit', second: '2-digit',
                hour12: false,
              });
            },
            label: ctx => ctx.dataset.yAxisID === 'yCpu'
              ? ` CPU: ${ctx.parsed.y.toFixed(1)}%`
              : ` Requests: ${ctx.parsed.y}`,
          },
        },
      },
    },
  });
}

// ---------------------------------------------------------------- stat tiles
function renderStats(pts) {
  document.getElementById('stat-tiles').style.display = '';
  const vals = pts.map(p => p.cpu_pct);
  const avg  = vals.reduce((s, v) => s + v, 0) / vals.length;
  const peak = Math.max(...vals);
  document.getElementById('stat-avg').textContent   = avg.toFixed(1)  + '%';
  document.getElementById('stat-peak').textContent  = peak.toFixed(1) + '%';
  document.getElementById('stat-count').textContent = pts.length.toLocaleString();
}
</script>
{% endblock %}
