# Copy to docker-compose.override.yml and add to .gitignore.
# This file supplies non-secret environment variables and the host log
# directory mounts for the follower service.
# Docker Compose merges it automatically with docker-compose.yml.
#
# SECRETS are NOT in this file — they are read from files under config/.
# See the "Secret files to create" section below.
#
# Both services use the same image and most of the same environment variables,
# so we define them once using a YAML anchor (&app-env) and reuse it (<<: *env).

x-app-env: &app-env
  # Logmon's own DB — host is the db service name, password comes from secret file
  DATABASE_URL: "mysql+mysqldb://logmon@db/logmon"

  # Shared users DB — reachable via the 'users' Docker network.
  # Host is whatever the users-DB container is named on that network.
  USERS_DATABASE_URL: "mysql+mysqldb://appuser@usersdb/users"

  # Mail (password comes from secret file)
  MAIL_SERVER: "smtp.example.com"
  MAIL_PORT: "587"
  MAIL_USE_TLS: "true"
  MAIL_USERNAME: "logmon@example.com"
  MAIL_DEFAULT_SENDER: "logmon@example.com"
  ALERT_RECIPIENTS: "you@example.com,oncall@example.com"

  # Alert suppression window in seconds (default 3600 = 1 hour)
  ALERT_SUPPRESS_SECONDS: "3600"

  # Redis — shared live-tail buffer (matches service name in docker-compose.yml)
  REDIS_URL: "redis://redis:6379/0"

  # SNS: comma-separated Topic ARNs to accept (blank = accept all)
  SNS_TOPIC_ARNS: "arn:aws:sns:us-east-1:123456789012:my-topic"

services:
  app:
    environment:
      <<: *app-env

  follower:
    environment:
      <<: *app-env

      # --- disk monitor (all optional, shown with defaults) ---
      DISK_ALERT_THRESHOLD_PCT: "85"    # alert when any filesystem >= this %
      DISK_CHECK_INTERVAL: "60"         # seconds between df / docker checks
      DISK_ALERT_SUPPRESS_SECONDS: "14400" # seconds between repeat alerts for the same mount (4 h); overrides ALERT_SUPPRESS_SECONDS for disk alerts
      DISK_SNAPSHOT_HISTORY: "1440"     # snapshots to keep in Redis (24 h @ 1/min)

    volumes:
      # HOW VOLUME MOUNTS CONNECT TO config/logapps.yml
      # -------------------------------------------------
      # Each line below has the form:
      #
      #   - /host/path/to/logs:/container/path:ro
      #     ^^^^^^^^^^^^^^^^^^^^  ^^^^^^^^^^^^^^
      #     your server's path    must match log_dir in logapps.yml
      #
      # The container path (right of the colon, before :ro) is arbitrary —
      # but it must be copied verbatim into log_dir in config/logapps.yml.
      # Nothing enforces this automatically; a mismatch means the follower
      # silently watches nothing for that app.
      #
      # On Windows with spaces in the path, quote the entire string:
      #   - "C:/Users/you/My Apps/contracts/logs:/logs/contracts:ro"
      #
      - /opt/apps/contracts/logs:/logs/contracts:ro   # log_dir: /logs/contracts
      - /opt/apps/rrwebapp/logs:/logs/rrwebapp:ro     # log_dir: /logs/rrwebapp
      # Add more as needed — then add a matching entry in config/logapps.yml:
      # - /opt/apps/myapp/logs:/logs/myapp:ro         # log_dir: /logs/myapp

      # If any access log is in a different directory, mount that too:
      # - /var/log/apache2:/var/log/apache2:ro

      # docker disk management
      - /var/run/docker.sock:/var/run/docker.sock:ro
      # Windows (Docker Desktop) — comment out the Linux line above and use:
      # - //./pipe/docker_engine:/var/run/docker.sock

      # disk monitoring volumes
      - /:/host/root:ro
      - /mnt/x:/host/mnt/x:ro   # repeat for each volume you want to monitor

  db:
    environment:
      MYSQL_USER: logmon
      MYSQL_DATABASE: logmon

# ------------------------------------------------------------------ Secret files to create
# Create these files before running docker compose up.
# All are gitignored via the config/ entry in .gitignore.
#
#   config/secret-key.txt              — Flask SECRET_KEY (random hex string)
#   config/security-password-salt.txt  — Flask-Security password salt (random hex)
#   config/mail-password.txt           — SMTP password
#   config/snswebhook-key.txt          — SNS webhook shared secret key
#   config/db/root-password.txt        — MySQL root password
#   config/db/appdb-password.txt       — MySQL password for the logmon user
#   config/db/users-password.txt       — MySQL password for the shared users DB user
#
# Generate random values for secret-key.txt and security-password-salt.txt:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# SNS webhook URL to configure in AWS (key is read from snswebhook-key.txt):
#   https://yourhost/sns/webhook?key=<contents of snswebhook-key.txt>
